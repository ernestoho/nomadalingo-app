{
  "expo": {
    "name": "NómadaLingo",
    "slug": "nomadalingoapp",
    "owner": "ernexto",
    "version": "1.0.0",
    "sdkVersion": "57.0.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "orientation": "portrait",
    "icon": "./assets/images/native-brand/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "nomadalingo",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "usesAppleSignIn": true,
      "supportsTablet": false,
      "bundleIdentifier": "com.ernestoho.nomadalingo",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ernestoho.nomadalingo",
      "adaptiveIcon": {
        "backgroundColor": "#FDF8F1",
        "foregroundImage": "./assets/images/native-brand/adaptive-foreground.png",
        "monochromeImage": "./assets/images/native-brand/adaptive-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./public/icons/icon-192.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDF8F1",
          "image": "./assets/images/native-brand/splash.png",
          "imageWidth": 190,
          "resizeMode": "contain"
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-secure-store",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6f82340f-78e3-4f89-9273-2feb038a1053"
      }
    }
  }
}
