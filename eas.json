{
  "cli": {
    "version": ">= 16.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": true,
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "environment": "preview"
    },
    "simulator": {
      "distribution": "internal",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_USE_RN_FETCH": "1"
      },
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_USE_RN_FETCH": "1"
      }
    }
  },
  "submit": {
    "development": {},
    "production": {}
  }
}
