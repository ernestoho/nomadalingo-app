# Copy to .env and fill in real values.
# These are public client values (inlined into the bundle at build time) and
# are protected by row-level security on the backend, not by secrecy.
# Never commit .env — it is gitignored.

EXPO_PUBLIC_BILT_URL=https://your-project-id.cloud.bilt.me
EXPO_PUBLIC_BILT_ANON_KEY=your-anon-key
